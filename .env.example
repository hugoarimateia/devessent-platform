# ==============================================================================
# DEVESSENT PLATFORM CORE — ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================
# IMPORTANTE:
# - Nunca insira credenciais reais de produção neste arquivo ou no repositório.
# - Copie este arquivo para .env.local para desenvolvimento local.
# - Todas as variáveis são validadas estritamente via Zod em src/lib/environment/env.ts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Seleção Explícita de Ambiente / Backend
# ------------------------------------------------------------------------------
# Valores permitidos:
#   - supabase   (Padrão oficial: Supabase Local ou Supabase Cloud)
#   - xampp-test (Exclusivo para testes locais em desenvolvimento com MariaDB/XAMPP)
APP_BACKEND_MODE=supabase

NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Oficial — Configuração Pública (Client-Side e Server-Side)
# ------------------------------------------------------------------------------
# URL pública do projeto Supabase (Local: http://127.0.0.1:54321 | Cloud: https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública (Anon / Publishable Key)
# Segura para exposição no browser; acessos restritos estritamente por RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyZXNlcnZlZCI6InBsYWNlaG9sZGVyLWFub24ta2V5In0.placeholder

# ------------------------------------------------------------------------------
# 3. Supabase Oficial — Configuração Privada (Server-Only / Processos Confiáveis)
# ------------------------------------------------------------------------------
# Chave Service Role com bypass de RLS
# NUNCA exponha no client-side ou no bundle do browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyZXNlcnZlZCI6InBsYWNlaG9sZGVyLXNlcnZpY2Utcm9sZSJ9.placeholder

# Conexão direta PostgreSQL (apenas para migrations e scripts administrativos)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# 4. Isolamento e Proteção de Sandbox (Supabase Local / Staging Autorizado)
# ------------------------------------------------------------------------------
# Identificador exclusivo do projeto autorizado para seeds e resets locais
# Nunca aponte para um projeto de produção.
AUTHORIZED_SANDBOX_PROJECT_ID=devessent-platform-local

# ------------------------------------------------------------------------------
# 5. Ambiente Secundário de Testes Locais — XAMPP / MariaDB (SEM DOCKER)
# ------------------------------------------------------------------------------
# Utilizado SOMENTE quando APP_BACKEND_MODE=xampp-test em NODE_ENV=development|test.
# Proibido em builds de produção (fail-closed).
XAMPP_DB_HOST=127.0.0.1
XAMPP_DB_PORT=3306
XAMPP_DB_USER=root
XAMPP_DB_PASSWORD=
XAMPP_DB_NAME=devessent_test
XAMPP_SESSION_SECRET=dev-xampp-local-session-secret-change-me-32chars
XAMPP_STORAGE_DIR=local-test/xampp/storage
