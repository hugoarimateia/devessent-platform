# ==============================================================================
# DEVESSENT PLATFORM — ESPECIFICAÇÃO DE VARIÁVEIS DE AMBIENTE (APENAS PLACEHOLDERS)
# ==============================================================================
# REGRAS DE SEGURANÇA:
# - Este arquivo é versionado apenas como modelo. NUNCA insira segredos reais aqui.
# - Credenciais reais ficam somente em arquivos ignorados pelo Git:
#     * .env.staging.local -> Supabase Cloud Staging (preferencial: pnpm dev:staging)
#     * .env.local         -> Ambiente local / XAMPP MariaDB (pnpm dev:xampp)
# - Nunca coloque segredos em variáveis NEXT_PUBLIC_*.
# - Todas as variáveis são validadas estritamente via Zod em src/lib/environment/env.ts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Seleção Explícita de Backend
# ------------------------------------------------------------------------------
# Valores permitidos:
#   - supabase   (Oficial: Supabase Cloud Staging ou futura Produção)
#   - xampp-test (Secundário offline local: MariaDB/XAMPP — proibido em produção)
APP_BACKEND_MODE=supabase

NODE_ENV=development
# Valores permitidos: development | test | staging | production
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AMBIENTE A — SUPABASE CLOUD STAGING (.env.staging.local)
# ------------------------------------------------------------------------------
# Projeto oficial de homologação da organização DevEssent:
#   Nome: dev-essent.stagging | Project Ref: auebnppzxcvtaaqqlbts
DEVESSENT_EXPECTED_STAGING_PROJECT_REF=auebnppzxcvtaaqqlbts

# URL pública do projeto Supabase Cloud (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Chave pública (Anon / Publishable Key — restrita por RLS no PostgreSQL)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<CHAVE_PUBLICA_SUPABASE_AQUI>

# Chave privada de servidor (Service Role — NUNCA expor no navegador)
SUPABASE_SERVICE_ROLE_KEY=<CHAVE_SERVICE_ROLE_SERVIDOR_AQUI>

# Chave mestra server-only para criptografia AES-256-GCM de credenciais Sandbox (32 bytes hex)
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=<CHAVE_HEX_64_CHARS_EXCLUSIVA_SERVIDOR>

# ------------------------------------------------------------------------------
# 3. AMBIENTE B — XAMPP / MARIADB LOCAL (.env.local — SEM DOCKER)
# ------------------------------------------------------------------------------
# Utilizado exclusivamente por pnpm dev:xampp (APP_BACKEND_MODE=xampp-test).
# Nenhuma consulta ao Supabase é feita em modo xampp-test.
XAMPP_DB_HOST=127.0.0.1
XAMPP_DB_PORT=3306
XAMPP_DB_USER=root
XAMPP_DB_PASSWORD=
XAMPP_DB_NAME=devessent_test
XAMPP_SESSION_SECRET=<SEGREDO_LOCAL_XAMPP_MIN_32_CARACTERES>
XAMPP_STORAGE_DIR=local-test/xampp/storage

# ------------------------------------------------------------------------------
# 4. AMBIENTE LOCAL LEGADO / SANDBOX GUARD (Apenas se usar Supabase Docker local)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# AUTHORIZED_SANDBOX_PROJECT_ID=devessent-platform-local

# ------------------------------------------------------------------------------
# 5. FUTURA PRODUÇÃO COMERCIAL (NÃO CONFIGURAR LOCALMENTE)
# ------------------------------------------------------------------------------
# Na futura produção (Cloudflare + projeto Supabase de produção dedicado):
# - Configurar variáveis apenas no cofre de secrets da hospedagem.
# - Utilizar projeto Supabase separado do staging (auebnppzxcvtaaqqlbts).
# - Nunca habilitar APP_BACKEND_MODE=xampp-test em produção.
