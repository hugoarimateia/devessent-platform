# ==============================================================================
# DEVESSENT CATALOG SCANNER — CONFIGURAÇÃO PRIVATIVA (STAGING)
# Copie para .env.scanner.local ou execute: pnpm setup:staging-env
# NUNCA versione .env.scanner.local nem exponha segredos no frontend.
# ==============================================================================

# Ambiente alvo (nesta fase: exclusivamente staging autorizado auebnppzxcvtaaqqlbts)
SCANNER_ENV=staging
SCANNER_PORT=3020
APP_BACKEND_MODE=supabase

# Supabase Cloud Staging (APENAS servidor; não usar NEXT_PUBLIC_ para chaves privilegiadas)
SUPABASE_URL=https://auebnppzxcvtaaqqlbts.supabase.co
SUPABASE_ANON_KEY=PREENCHER_COM_ANON_KEY_DO_STAGING
SUPABASE_SERVICE_ROLE_KEY=PREENCHER_COM_SERVICE_ROLE_KEY_DO_STAGING

# Dupla Autorização Obrigatória (Fail-Closed: sem UUID listado, ninguém acessa!)
# Lista separada por vírgula de user_id (UUID em auth.users + platform_admins)
CATALOG_SCANNER_ALLOWED_USER_IDS=PREENCHER_COM_UUID_DO_PROPRIETARIO_DEVESSENT
# Opcional: lista adicional de e-mails autorizados (cross-check)
CATALOG_SCANNER_ALLOWED_EMAILS=

# Segredo HMAC-SHA256 (>= 32 caracteres) para assinar o cookie HttpOnly de sessão do scanner
CATALOG_SCANNER_SESSION_SECRET=PREENCHER_COM_SEGREDO_ALEATORIO_MIN_32_CHARS

# Integrações externas autorizadas (opcional; padrão: somente catálogos autorizados locais)
# Valores opcionais: "openfoodfacts" (base aberta ODbL). Nunca habilita scraping ou APIs pagas.
CATALOG_SCANNER_OPEN_LOOKUP=disabled

# Domínios HTTPS explicitamente autorizados para download opcional de imagens de fornecedores
# Deixe vazio para aceitar apenas arquivos enviados localmente / fotografias (anti-SSRF).
CATALOG_SCANNER_ALLOWED_IMAGE_HOSTS=
