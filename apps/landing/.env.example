# ============================================================================
# DevEssent Landing Page — Variáveis Públicas (Cloudflare Pages / Local)
# ATENÇÃO: NUNCA inserir service_role, chaves privadas ou segredos neste arquivo.
# Variáveis NEXT_PUBLIC_* ficam embutidas no bundle estático do navegador.
# ============================================================================

# URL canônica pública da landing (ex.: https://devessent-landing.pages.dev ou https://devessent.com.br)
NEXT_PUBLIC_SITE_URL="https://devessent-landing.pages.dev"

# Canal direto de WhatsApp comercial (somente dígitos com DDI + DDD, ex.: 5511999999999)
NEXT_PUBLIC_CONTACT_WHATSAPP=""

# Perfil oficial do Instagram (URL completa ou @usuario, ex.: https://instagram.com/devessent)
NEXT_PUBLIC_CONTACT_INSTAGRAM=""

# E-mail comercial público para retorno de propostas
NEXT_PUBLIC_CONTACT_EMAIL=""

# Endpoint opcional da Supabase Edge Function de marketing (projeto dedicado da landing)
# Exemplo: https://<project-ref>.supabase.co/functions/v1/marketing-contact
# Quando vazio, o formulário opera com validação local + encaminhamento assistido (WhatsApp/E-mail/Cópia).
NEXT_PUBLIC_CONTACT_ENDPOINT=""

# Chave pública anon/publishable do projeto Supabase de marketing (opcional, nunca service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Site Key pública do Cloudflare Turnstile (habilita desafio antispam quando definida)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
